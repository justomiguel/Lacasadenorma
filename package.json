{
  "name": "la-casa-de-norma",
  "version": "0.1.0",
  "private": true,
  "description": "La Casa de Norma — reconstruimos una casa, construimos un legado.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "next typegen && eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e:sin-datos && npm run test:e2e:con-datos",
    "test:e2e:sin-datos": "./scripts/e2e.sh sin-datos",
    "test:e2e:con-datos": "./scripts/e2e.sh con-datos",
    "api:local": "node scripts/local-api.mjs",
    "db:bootstrap": "./scripts/db-local.sh bootstrap",
    "db:verify": "./scripts/db-local.sh verify",
    "db:reset": "./scripts/db-local.sh reset",
    "db:fixture": "./scripts/db-local.sh fixture",
    "db:lint": "./scripts/db-local.sh lint",
    "db:advisors": "./scripts/db-local.sh advisors",
    "db:test": "./scripts/db-local.sh test",
    "db:types": "./scripts/db-local.sh types",
    "db:new": "supabase migration new",
    "check:placeholders": "node scripts/check-no-placeholders.mjs",
    "check:secrets": "node scripts/check-no-client-secrets.mjs",
    "check:fotos": "node scripts/check-fotos.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run check:placeholders && npm run check:secrets && npm run check:fotos && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@supabase/postgrest-typegen": "0.2.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}

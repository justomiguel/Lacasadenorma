# La Casa de Norma — variables de entorno
#
# Copiá este archivo a `.env.local` y completá los valores que necesites.
# `.env.local` está en .gitignore y nunca se commitea.
#
# El sitio LEVANTA Y FUNCIONA sin ninguna de estas variables: sin Supabase
# configurado muestra el contenido editorial y omite las cifras, con un aviso
# visible (FR-034). No hay valores de ejemplo porque un dato falso es peor que
# un dato ausente.

# ─────────────────────────────────────────────────────────────────────────────
# Sitio
# ─────────────────────────────────────────────────────────────────────────────

# URL canónica pública, sin barra final. Se usa en metadata, sitemap, JSON-LD y
# en la imagen de compartir. En Vercel, dejala vacía en preview: se deriva de
# VERCEL_URL automáticamente.
NEXT_PUBLIC_SITE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────

# URL del proyecto: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (antes "anon"). Viaja al navegador a propósito: la protección
# real es RLS, no el secreto de esta clave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (antes "service_role"). NO lleva prefijo NEXT_PUBLIC_ y NO se usa
# en código de cliente. Sólo hace falta para tareas administrativas fuera de la
# aplicación web. Si no sabés que la necesitás, dejala vacía.
SUPABASE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Base de datos local (desarrollo sin Docker) — ver docs/adr/013
# ─────────────────────────────────────────────────────────────────────────────

# Cadena de conexión que usan `npm run db:*`. El valor por defecto del script
# apunta al Postgres local levantado por scripts/db-local.sh.
LOCAL_DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# CI / despliegue (se configuran como secretos del repositorio, no acá)
# ─────────────────────────────────────────────────────────────────────────────

# VERCEL_TOKEN            token de despliegue de Vercel
# VERCEL_ORG_ID           identificador de la organización
# VERCEL_PROJECT_ID       identificador del proyecto
# SUPABASE_ACCESS_TOKEN   token personal para `supabase link` en CI
# SUPABASE_PROJECT_REF    referencia del proyecto de producción
# SUPABASE_DB_PASSWORD    contraseña de la base para aplicar migraciones

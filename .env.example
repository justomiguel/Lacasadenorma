# La Casa de Norma — variables de entorno
#
# Copiá este archivo a `.env.local` y completá los valores que necesites.
# `.env.local` está en .gitignore y nunca se commitea.
#
# El sitio LEVANTA Y FUNCIONA sin ninguna de estas variables: sin Supabase
# configurado muestra el contenido editorial y omite las cifras, con un aviso
# visible (FR-034). No hay valores de ejemplo porque un dato falso es peor que
# un dato ausente.

# ─────────────────────────────────────────────────────────────────────────────
# Sitio
# ─────────────────────────────────────────────────────────────────────────────

# URL canónica pública, sin barra final. Se usa en metadata, sitemap, JSON-LD y
# en la imagen de compartir. En Vercel, dejala vacía en preview: se deriva de
# VERCEL_URL automáticamente.
NEXT_PUBLIC_SITE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────

# URL del proyecto: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (antes "anon"). Viaja al navegador a propósito: la protección
# real es RLS, no el secreto de esta clave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (antes "service_role"). NO lleva prefijo NEXT_PUBLIC_. En la
# aplicación web se usa **sólo** para `auth.admin.generateLink` cuando el hook
# de correo todavía no está: crea la cuenta y Resend manda la confirmación.
# Nunca para leer ni escribir la base. Si no sabés que la necesitás, dejala vacía.
SUPABASE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Correo — ver docs/adr/028
# ─────────────────────────────────────────────────────────────────────────────

# Las tres son del servidor y **ninguna lleva NEXT_PUBLIC_**: `npm run check:secrets`
# falla si alguna aparece en el JavaScript del navegador.
#
# Sin configurar, el sitio funciona completo: una reserva se completa igual, el envío
# queda registrado como `skipped` y la pantalla muestra los datos de entrega en lugar
# de prometer un correo que no va a llegar (FR-233, FR-236).

# Clave de API de Resend. El adaptador de **todos** los correos —identidad y producto—
# hace `POST https://api.resend.com/emails`. El relay SMTP de Auth (`supabase/config.toml`,
# `[auth.email.smtp]`) queda de respaldo para recuperar y cambiar de dirección si el hook
# todavía no está. Rotarla es rotarla en los dos lugares hasta que el hook tome los tres.
RESEND_API_KEY=

# Dirección remitente. Su dominio tiene que estar verificado en Resend con SPF, DKIM y
# DMARC antes de que salga un solo correo; el procedimiento está en docs/runbook.md.
EMAIL_FROM_ADDRESS=

# Dirección del equipo, que recibe el aviso de una cuenta nueva o de una reserva. Sin ella, la
# operación se registra igual y nadie recibe el aviso. El correo a la persona sale igual.
EMAIL_STAFF_ADDRESS=

# Secreto del hook `send_email` de Auth (Standard Webhooks: `v1,whsec_…`).
# **Sólo** cuando el hook está habilitado en el panel. Si está acá y el hook no,
# el alta deja de mandar la confirmación por `generateLink` y Auth tampoco llama
# a `/api/correo/identidad`.
SEND_EMAIL_HOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Redes sociales — ver docs/adr/039
# ─────────────────────────────────────────────────────────────────────────────

# Lista separada por comas de las redes que este sitio ofrece para crear cuenta
# e ingresar. Vacía: ningún botón. No lleva NEXT_PUBLIC_: la página, que es un
# Server Component, lee la lista y baja los ids por props.
#
# Los ids son los de la marca: google, apple, facebook, x, github, gitlab,
# linkedin, discord, twitch, spotify. Habilitar el proveedor en el panel de
# Supabase no alcanza: sin esta variable el botón no existe. El procedimiento
# está en docs/runbook.md.
AUTH_SOCIAL_PROVIDERS=

# ─────────────────────────────────────────────────────────────────────────────
# Analítica — ver docs/adr/010
# ─────────────────────────────────────────────────────────────────────────────

# Las dos van juntas: si falta una, no se carga nada. Sin configurar, el sitio no
# pide ningún recurso a terceros y no envía ningún evento, que es el estado por
# defecto y el que describe /legales/privacidad.
#
# URL del script del proveedor (compatible con Plausible: Plausible, Umami…). Su
# origen se agrega automáticamente a `script-src` y `connect-src` en la CSP.
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=

# El dominio tal como está dado de alta en el proveedor, sin protocolo.
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# ─────────────────────────────────────────────────────────────────────────────
# Base de datos local (desarrollo sin Docker) — ver docs/adr/013
# ─────────────────────────────────────────────────────────────────────────────

# Cadena de conexión que usan `npm run db:*`. El valor por defecto del script
# apunta al Postgres local levantado por scripts/db-local.sh.
LOCAL_DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# CI / despliegue (se configuran como secretos del repositorio, no acá)
# ─────────────────────────────────────────────────────────────────────────────

# VERCEL_TOKEN            token de despliegue de Vercel
# VERCEL_ORG_ID           identificador de la organización
# VERCEL_PROJECT_ID       identificador del proyecto
# SUPABASE_ACCESS_TOKEN   token personal para `supabase link` en CI
# SUPABASE_PROJECT_REF    referencia del proyecto de producción
# SUPABASE_DB_PASSWORD    contraseña de la base para aplicar migraciones
